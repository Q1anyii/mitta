# ============================================================
# .gitignore — 米塔 AI 智能客服
# ============================================================

# ---- 环境变量与密钥（严禁提交）----
.env
*.env
# 注意：.env.example 是模板文件，必须提交（不匹配 *.env，因为不以 .env 结尾）

# ---- SSH 凭据与 known_hosts（严禁提交）----
.ssh/
known_hosts
*known_hosts*
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
*.pem
*.p12
*.pfx
*.ppk

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ---- IDE 配置 ----
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# ---- 本地数据（向量库，需重建，不入库）----
resources/chroma_db/
recourses/chroma_db/
src/resources/chroma_db/
# 评测测试数据（src/agent_test 下的 chroma 库）纳入版本管理
!src/agent_test/resources/chroma_db/
!src/agent_test/resources/chroma_db/*

# ---- 缓存目录 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# ---- Jupyter 检查点 ----
.ipynb_checkpoints/

# ---- 操作系统 / 日志 / 临时文件 ----
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
*.bak
*.old

# ---- 前端构建产物（如有）----
node_modules/
dist/
build/
*.local

# ---- 测试覆盖率 ----
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ---- 临时脚本 / 个人配置 ----
*.local.py
# ---- Agent 治理文件（本地多 Agent 工作流，不入库）----
.agent/

config.local.py
src/ragas_eval/
/deploy/nginx/nginx-dev.conf
/database.db
/database.db-shm
/fix_reasoning_debug.py
/database.db-wal

# 本地路径残留（容器内会解析错误，禁止提交）
resources/config/.mcp_config_path
resources/config/.vector_config_path
# 路径被压平成单个文件名的产物
# 例：C:\Users\Qianyi\.ssh\known_hosts 曾被提交成 CUsersQianyi.sshknown_hosts
*UsersQianyi*


# ---- Mitta 本地运行时数据（测试生成，不入库）----
resources/chroma_data/
resources/mem0_chroma/
resources/local_data.db
resources/chroma.sqlite3

# TLS 证书/私钥：绝不进 git，手动上传服务器 /opt/mitta/deploy/ssl/
/deploy/ssl/
/AGENTS.md
/temp.md

# 临时工作目录与本地备份
.workbuddy/
resources/chroma_db_backup_*/

# 一次性审计/待办工作文件（不进仓库）
fixList.md
mitta_audit_report.md

